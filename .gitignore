# Default deny: only reviewed source, tests and safe examples may enter Git.
*
!*/
!/.gitignore
!/.gitattributes
!/.env.example
!/config.example.json
!/automation.example.json
!/requirements.txt
!/README.md
!/REPOSITORY_GUIDE.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md

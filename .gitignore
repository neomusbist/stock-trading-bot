!/main.py
!/candidate_builder.py
!/control.py
!/supervisor.py
!/operator_console.py
!/operator_service.py
!/operator_runner.py
!/operator_process.py
!/local_diagnostics.py
!/operator_ui_service.py
!/operator_gui.py
!/gui_launch.py
!/gui_menu.cmd
!/GUI_GUIDE.md
!/run.bat
!/test.bat
!/operator_menu.cmd
!/core/*.py
!/automation/*.py
!/tests/test_*.py
!/tests/fixtures/original_052260_daily.csv
!/tests/fixtures/README.md
!/reference/contract.json
!/tools/repo_guard.py
!/tools/setup_local.py
!/tools/export_source.py
# Explicit exclusions remain effective even with later allow rules.
.env
.env.*
!/.env.example
config.json
automation.json
*.local.*
*.local
policy.local.json
token*.json
credentials*
secrets*
/runtime/
/releases/
/vendor/
/gui_vendor/
/data/
/demo_output/
/github_source/
/reference/original/
**/__pycache__/
*.pyc
.pytest_cache/
.venv/
.idea/
.vscode/
*.tmp*
*.log
*.lock
*.dmp
*.exe
*.dll
Thumbs.db
